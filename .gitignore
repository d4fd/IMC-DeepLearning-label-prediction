# Default-deny: only explicitly reviewed source and documentation can be added.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/PUBLIC_FILES.txt
!/requirements*.txt
!/demo.py
!/verify_publication.py
!/docs/
/docs/*
!/docs/*.md
!/workflow/
/workflow/*
!/workflow/*.py
!/tests/
/tests/*
!/tests/test_*.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/check.yml

# Never include data, binary assets, credentials, notebooks or runtime output.
**/__pycache__/
**/*.pyc
**/.env*
**/*.csv
**/*.tsv
**/*.parquet
**/*.npz
**/*.npy
**/*.pt
**/*.pth
**/*.safetensors
**/*.tif
**/*.tiff
**/*.zarr/
**/*.ipynb
**/*.html
**/*.pdf
**/*.png
**/*.zip
**/*.log
**/*.pem
**/*.key
